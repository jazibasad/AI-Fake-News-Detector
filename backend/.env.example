# ─────────────────────────────────────────────
#  TruthLens — Environment Variables Template
#  Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Flask settings
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=change-this-to-any-random-string

# Ollama settings (runs locally — no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Guardian Open API (free, no card — get key at https://open-platform.theguardian.com)
GUARDIAN_API_KEY=your-guardian-api-key-here

# GDELT Project (completely free, no key required)
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
