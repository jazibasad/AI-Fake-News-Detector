# ─────────────────────────────────────────────────────
#  TruthLens — Environment Variables
#  Copy this file to:  ai-fake-news-detector/backend/.env
#  Then fill in your Guardian API key below.
# ─────────────────────────────────────────────────────

# Flask
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=truthlens-secret-change-me

# Ollama  (no key needed — runs locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Guardian Open Platform  (free key — get it at https://open-platform.theguardian.com)
# Takes 30 seconds to register, no credit card required.
GUARDIAN_API_KEY=your-guardian-api-key-here

# GDELT  (no key needed — completely open API)
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc

# Frontend origin  (do not change for local dev)
FRONTEND_URL=http://localhost:3000
